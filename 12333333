-- ฟังก์ชัน 3: Headless (หัวหาย)
local isHeadless = false
HeadlessBtn.MouseButton1Click:Connect(function()
    isHeadless = not isHeadless
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Head") then
        char.Head.Transparency = isHeadless and 1 or 0
        if char.Head:FindFirstChildOfClass("Decal") then
            char.Head:FindFirstChildOfClass("Decal").Transparency = isHeadless and 1 or 0
        end
    end
    HeadlessBtn.Text = "3. หัวหาย (Headless): " .. (isHeadless and "ON" or "OFF")
    HeadlessBtn.TextColor3 = isHeadless and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
end)

-- เกิดใหม่แล้วหัวหายต่อเนื่อง
LocalPlayer.CharacterAdded:Connect(function(char)
    if isHeadless then
        task.wait(0.5)
        if char:FindFirstChild("Head") then
            char.Head.Transparency = 1
            if char.Head:FindFirstChildOfClass("Decal") then
                char.Head:FindFirstChildOfClass("Decal").Transparency = 1
            end
        end
    end
end)

